# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Python build output。
# 这里刻意只写 `dist/`（只匹配仓库根目录），**不写 `**/dist/`** ——
# 后者的语义是"忽略任意层级的 dist 目录"，而 Git 不会进入被忽略的目录，
# 于是 `!web/dist/**` 这种"先忽略目录、再放行内部文件"的写法完全无效，
# 前端产物会静默地不被提交。这个坑很难发现，因为 `git status` 不报错。
dist/
build/*.egg-info/

# --- Node ---
node_modules/
web/node_modules/
web/.vite/
*.tsbuildinfo

# --- Frontend build output (intentionally committed) ---
# web/dist ships with the repo so the tool runs without a Node toolchain.
!web/dist/**

# --- Runtime / user data (never commit) ---
data/
workspace/
workspaces/
models/
logs/
*.log
.env
.env.*
!.env.example

# --- Local scratch ---
tmp/
.tmp/
scratch/
*.gguf
*.onnx
*.safetensors
*.pth

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store

# --- 开发脚手架（不入库） ---
.scratch/
